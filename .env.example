# 1. Cloud Database (Managed MySQL - Railway, Aiven, Clever Cloud, or PlanetScale)
SPRING_DATASOURCE_URL=jdbc:mysql://your-cloud-mysql-host:3306/sri_anjaneya_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# 2. Cloudinary Persistent CDN Image Storage (CRITICAL FOR CROSS-DEVICE SYNC)
# Free account at https://cloudinary.com -> Dashboard -> Copy API Environment Variable details
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. Security & Admin Authentication
JWT_SECRET=sriAnjaneyaFertilizersSecureKey2026AgriculturalShopTelanganaIndia1234567890
JWT_EXPIRATION_MS=604800000
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminPassword123!

# 4. Shop Contact & WhatsApp
SHOP_WHATSAPP_NUMBER=917095891270
SHOP_PHONE_NUMBER=917095891270

# 5. Frontend Vercel Environment Variable (set in Vercel project settings)
# Points to your deployed Spring Boot backend URL
VITE_API_BASE_URL=https://your-backend-service.up.railway.app
