# Spring Boot Server Port
PORT=8080

# Spring Active Profile (mysql for production/local MySQL, dev for local file H2)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sri_anjaneya_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Cloudinary Credentials (REQUIRED for persistent cross-device image uploads)
# Sign up free at https://cloudinary.com and copy from your Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security & JWT Configuration (Generate a strong 32+ character random secret)
JWT_SECRET=your_strong_32_character_jwt_secret_key_sri_anjaneya_2026
JWT_EXPIRATION_MS=604800000

# Initial Admin Bootstrap Credentials (created automatically on first boot)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminPassword123!

# Shop Contact & WhatsApp Configuration
SHOP_WHATSAPP_NUMBER=917095891270
SHOP_PHONE_NUMBER=917095891270

# CORS Allowed Origins (Comma-separated, include local dev & deployed Vercel domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
